    /* ==========================================================================
       ส่วนที่ 6: เริ่มเกม & กลไกการประมูล (PHASE 1: LIVE AUCTION)
       ========================================================================== */
    function clearAllTimers() {
      if (state.timerInterval) clearInterval(state.timerInterval);
      if (state.botInterval) clearInterval(state.botInterval);
      state.timerInterval = null;
      state.botInterval = null;
    }

    function getCurrentLevelData() {
      return GAME_CONFIG.levels.find(l => l.id === state.selectedLevel) || GAME_CONFIG.levels[0];
    }

    function startGame() {
      clearAllTimers();
      const lvl = getCurrentLevelData();
      state.coins = 24;
      state.score = 0;
      state.vitals = { health: 40, study: 40, happy: 40 };
      state.itemIndex = 0;
      state.wonItems = [];
      state.plannerAssignments = {};
      state.selectedPlanCardId = null;
      state.hintUsed = false;
      state.goodDecisions = 0;
      state.totalDecisions = 0;

      // รีเซ็ตเหรียญของบอทในด่าน
      lvl.bots.forEach(b => b.coins = 24);

      const hintBtn = document.getElementById("btn-hint");
      hintBtn.disabled = false;
      hintBtn.textContent = "💡 ที่ปรึกษาเวลา (1)";

      SFX.coin();
      switchScreen("screen-auction");
      updateHUD();
      loadAuctionRound();
    }

    function updateHUD() {
      document.getElementById("hud-coins").textContent = state.coins;
      document.getElementById("hud-score").textContent = state.score;

      ["health", "study", "happy"].forEach(key => {
        const val = Math.max(0, Math.min(100, state.vitals[key]));
        state.vitals[key] = val;
        document.getElementById(`val-${key}`).textContent = `${val}%`;
        document.getElementById(`bar-${key}`).style.width = `${val}%`;
      });

      const mood = state.vitals.health <= 25 ? "tired" : "happy";
      document.getElementById("auction-mascot-mini").innerHTML = renderDogMascotSVG(state.selectedChar, mood, 68);

      const totalHours = state.wonItems.reduce((sum, it) => sum + it.hours, 0);
      document.getElementById("total-won-hours").textContent = `รวม ${totalHours} / 24 ชม.`;

      const listEl = document.getElementById("won-items-list");
      if (state.wonItems.length === 0) {
        listEl.innerHTML = `<span style="font-size:0.82rem; color:#94a3b8;">ยังไม่มีกิจกรรม — ลองประมูลกิจกรรมแรกเลย!</span>`;
      } else {
        listEl.innerHTML = state.wonItems.map(it =>
          `<span class="won-chip">${it.icon} ${it.title} (${it.hours} ชม.)</span>`
        ).join("");
      }
    }

    function loadAuctionRound() {
      clearAllTimers();
      const lvl = getCurrentLevelData();

      if (state.itemIndex >= lvl.items.length || state.coins <= 0) {
        startPlannerPhase();
        return;
      }

      const item = lvl.items[state.itemIndex];
      state.currentBid = item.basePrice;
      state.highestBidder = "ราคาเริ่มต้น";
      state.playerIsHighest = false;
      state.timeLeft = lvl.timerSec;

      document.getElementById("round-indicator").textContent = `รายการที่ ${state.itemIndex + 1} / ${lvl.items.length}`;
      document.getElementById("level-badge-name").textContent = lvl.name;
      document.getElementById("item-icon").textContent = item.icon;
      document.getElementById("item-title").textContent = item.title;
      document.getElementById("item-desc").textContent = item.desc;
      document.getElementById("item-hours").textContent = item.hours;
      document.getElementById("item-slots").textContent = item.slots;

      const tagEl = document.getElementById("item-matrix-tag");
      tagEl.textContent = `หมวด: ${item.matrixLabel}`;
      tagEl.className = `eisenhower-tag tag-${item.matrix}`;

      renderAuctionBidState();
      renderBotsList();

      // ตั้งเวลานับถอยหลังต่อรอบ
      const timerEl = document.getElementById("auction-timer");
      timerEl.classList.remove("urgent");
      timerEl.textContent = `⏱️ ${state.timeLeft} วิ`;

      state.timerInterval = setInterval(() => {
        state.timeLeft--;
        timerEl.textContent = `⏱️ ${state.timeLeft} วิ`;
        if (state.timeLeft <= 5 && state.timeLeft > 0) {
          timerEl.classList.add("urgent");
          SFX.tick();
        }
        if (state.timeLeft <= 0) {
          resolveCurrentAuction();
        }
      }, 1000);

      // ตั้งจังหวะให้บอท AI แข่งเสนอราคาอย่างสมจริง
      state.botInterval = setInterval(() => {
        simulateBotBid(item, lvl);
      }, 3400);
    }

    function renderAuctionBidState() {
      document.getElementById("current-bid").textContent = state.currentBid;
      document.getElementById("highest-bidder").textContent = state.highestBidder;

      const minNext1 = state.highestBidder === "ราคาเริ่มต้น" ? state.currentBid : state.currentBid + 1;
      const minNext2 = state.highestBidder === "ราคาเริ่มต้น" ? state.currentBid + 1 : state.currentBid + 2;

      const btn1 = document.getElementById("btn-bid-1");
      const btn2 = document.getElementById("btn-bid-2");

      btn1.textContent = `🔨 เสนอราคา (${minNext1} เหรียญ)`;
      btn2.textContent = `⚡ เกทับ (${minNext2} เหรียญ)`;

      btn1.disabled = state.coins < minNext1 || state.playerIsHighest;
      btn2.disabled = state.coins < minNext2 || state.playerIsHighest;
    }

    function renderBotsList() {
      const lvl = getCurrentLevelData();
      const container = document.getElementById("bots-list");
      container.innerHTML = lvl.bots.map(b => {
        const isLead = state.highestBidder === b.name;
        return `
          <div class="bot-row ${isLead ? "leading" : ""}">
            <span>${b.name} ${isLead ? "🔥" : ""}</span>
            <span style="color:#854d0e; font-weight:700;">🪙 ${b.coins}</span>
          </div>
        `;
      }).join("");
    }

    function placePlayerBid(step) {
      const lvl = getCurrentLevelData();
      const item = lvl.items[state.itemIndex];
      const nextPrice = state.highestBidder === "ราคาเริ่มต้น"
        ? state.currentBid + (step - 1)
        : state.currentBid + step;

      if (state.coins < nextPrice) {
        setFeedback("warn", "🪙 เหรียญเวลาของคุณไม่พอสำหรับราคานี้แล้ว!");
        return;
      }

      SFX.coin();
      state.currentBid = nextPrice;
      state.highestBidder = "คุณ (ผู้เล่น)";
      state.playerIsHighest = true;

      renderAuctionBidState();
      renderBotsList();
      setFeedback("info", `🔨 คุณเสนอราคา ${nextPrice} เหรียญสำหรับ "${item.title}"! รอดูว่าคู่แข่งจะสู้ราคาหรือไม่...`);
    }

    function simulateBotBid(item, lvl) {
      if (state.timeLeft <= 2) return;
      // เลือกบอทที่สนใจกิจกรรมประเภทนี้และยังมีเหรียญพอ
      const nextPrice = state.highestBidder === "ราคาเริ่มต้น" ? state.currentBid : state.currentBid + 1;
      const maxWilling = item.basePrice + (item.slots === 1 ? 3 : 2);
      if (nextPrice > maxWilling) return;

      const eligibleBots = lvl.bots.filter(b => b.coins >= nextPrice && state.highestBidder !== b.name);
      if (eligibleBots.length === 0) return;

      // โอกาส 55% ที่บอทจะเคาะราคาเพิ่ม
      if (Math.random() < 0.55) {
        const bot = eligibleBots[Math.floor(Math.random() * eligibleBots.length)];
        state.currentBid = nextPrice;
        state.highestBidder = bot.name;
        state.playerIsHighest = false;
        renderAuctionBidState();
        renderBotsList();
        setFeedback("info", `📢 ${bot.name} เคาะราคาแข่งที่ ${nextPrice} เหรียญ!`);
      }
    }

    function passCurrentAuction() {
      const lvl = getCurrentLevelData();
      const item = lvl.items[state.itemIndex];
      state.totalDecisions++;
      if (!item.isGood) {
        state.goodDecisions++;
        state.score += 3;
        setFeedback("good", `👏 ฉลาดมาก! คุณเลือกข้าม "${item.title}" ทำให้ประหยัดเวลาไว้ใช้กับเรื่องสำคัญ (+3 คะแนน)`);
      } else {
        setFeedback("info", `⏭️ คุณเลือกผ่าน "${item.title}" เพื่อเก็บเหรียญไว้รอกิจกรรมอื่น`);
      }
      state.itemIndex++;
      updateHUD();
      setTimeout(loadAuctionRound, 900);
    }

    function resolveCurrentAuction() {
      clearAllTimers();
      const lvl = getCurrentLevelData();
      const item = lvl.items[state.itemIndex];
      state.totalDecisions++;

      if (state.playerIsHighest && state.coins >= state.currentBid) {
        // ผู้เล่นชนะการประมูล!
        SFX.gavel();
        state.coins -= state.currentBid;
        state.wonItems.push({ ...item, paid: state.currentBid });
        state.score += item.points;

        state.vitals.health += item.effects.health;
        state.vitals.study += item.effects.study;
        state.vitals.happy += item.effects.happy;

        if (item.isGood) {
          state.goodDecisions++;
          spawnFloatingEmoji(item.icon);
          setFeedback("good", `🎉 ปิดประมูล! คุณได้ "${item.title}" (${state.currentBid} เหรียญ) พลังชีวิตเพิ่มขึ้นอย่างสมดุล!`);
        } else {
          spawnFloatingEmoji("⚠️");
          setFeedback("warn", `😅 คุณประมูล "${item.title}" ไป ${state.currentBid} เหรียญ — ระวังเสียค่าเสียโอกาสในการทำสิ่งสำคัญ!`);
        }
      } else {
        // บอทได้ไป
        const winnerBot = lvl.bots.find(b => b.name === state.highestBidder);
        if (winnerBot) winnerBot.coins = Math.max(0, winnerBot.coins - state.currentBid);
        if (!item.isGood) state.goodDecisions++;
        setFeedback("info", `🔨 ปิดประมูล! ${state.highestBidder === "ราคาเริ่มต้น" ? "ไม่มีผู้ประมูลรายการนี้" : state.highestBidder + " ชนะรายการนี้ไป"}`);
      }

      updateHUD();

      // ตรวจสอบเงื่อนไขแพ้ทันทีหากพลังชีวิตลดลงเหลือ 0
      if (checkImmediateGameOver()) return;

      state.itemIndex++;
      setTimeout(loadAuctionRound, 1300);
    }

    function spawnFloatingEmoji(symbol) {
      const el = document.createElement("div");
      el.className = "floating-reward";
      el.textContent = symbol;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 1450);
    }

    function setFeedback(type, msg) {
      const box = document.getElementById("auction-feedback");
      box.className = `feedback-banner ${type === "warn" ? "warn" : type === "good" ? "good" : ""}`;
      document.getElementById("feedback-text").textContent = msg;
    }

    /* ระบบลากเหรียญวางบนแท่นประมูล (Drag & Drop Coin) */
    function handleCoinDragStart(e) {
      e.dataTransfer.setData("text/plain", "bid-coin");
    }
    function handleCoinDragOver(e) {
      e.preventDefault();
      document.getElementById("podium-dropzone").classList.add("drag-over");
    }
    function handleCoinDragLeave() {
      document.getElementById("podium-dropzone").classList.remove("drag-over");
    }
    function handleCoinDrop(e) {
      e.preventDefault();
      document.getElementById("podium-dropzone").classList.remove("drag-over");
      placePlayerBid(1);
    }

    /* ระบบคำใบ้: ที่ปรึกษาเวลา (Hint System) */
    function useTimeAdvisor() {
      if (state.hintUsed) return;
      state.hintUsed = true;
      state.score = Math.max(0, state.score - 2);
      const btn = document.getElementById("btn-hint");
      btn.disabled = true;
      btn.textContent = "💡 ใช้คำใบ้แล้ว (-2)";
      updateHUD();

      const hasSleep = state.wonItems.some(i => i.id === "sleep8" || i.id === "nap_power");
      let advice = "";
      if (!hasSleep) {
        advice = "🐶 คำแนะนำจากน้องหมา: คุณยังไม่มีการ์ด 'นอนหลับ/พักสายตา' เลย! ควรเก็บเหรียญไว้ประมูลการนอนเพื่อป้องกันการล้มป่วยท้ายวัน";
      } else if (state.vitals.study < 55) {
        advice = "🐶 คำแนะนำจากน้องหมา: ด้าน 'การเรียน' ยังต่ำอยู่ ลองมองหากิจกรรมหมวด 'สำคัญ' อย่างการตั้งใจเรียนหรืออ่านหนังสือนะ";
      } else if (state.vitals.health < 55 || state.vitals.happy < 55) {
        advice = "🐶 คำแนะนำจากน้องหมา: อย่าลืมเติมพลังด้าน 'สุขภาพหรือครอบครัว' เพื่อรักษาสมดุล 8-8-8 ให้ครบทุกด้าน!";
      } else {
        advice = "🐶 คำแนะนำจากน้องหมา: สมดุลชีวิตของคุณยอดเยี่ยมมาก! หลีกเลี่ยงการ์ดสีเทา (ไถโซเชียล/ดูซีรีส์) เพื่อรักษาคะแนนสูงสุดไว้";
      }
      SFX.coin();
      setFeedback("good", advice);
    }

    /* ==========================================================================
       ส่วนที่ 7: ขั้นตอนที่ 2 - จัดตารางสมดุล 8-8-8 (DRAG & DROP / TAP PLANNER)
       ========================================================================== */
    function startPlannerPhase() {
      clearAllTimers();
      if (state.wonItems.length === 0) {
        // กรณีผู้เล่นไม่ประมูลอะไรเลย ข้ามไปเหตุการณ์ท้ายวันทันที
        startTwistPhase();
        return;
      }
      switchScreen("screen-planner");
      renderPlannerBoard();
    }

    function renderPlannerBoard() {
      const tray = document.getElementById("unassigned-tray");
      const zones = {
        rest: document.getElementById("zone-rest-items"),
        work: document.getElementById("zone-work-items"),
        life: document.getElementById("zone-life-items")
      };

      tray.innerHTML = "";
      Object.values(zones).forEach(z => z.innerHTML = "");

      state.wonItems.forEach(item => {
        const assignedZone = state.plannerAssignments[item.id];
        const cardEl = document.createElement("div");
        cardEl.className = `plan-card ${state.selectedPlanCardId === item.id ? "selected-card" : ""}`;
        cardEl.draggable = true;
        cardEl.innerHTML = `${item.icon} ${item.title} (${item.hours} ชม.)`;

        cardEl.ondragstart = (e) => {
          e.dataTransfer.setData("text/plain", item.id);
        };
        cardEl.onclick = (e) => {
          e.stopPropagation();
          state.selectedPlanCardId = (state.selectedPlanCardId === item.id) ? null : item.id;
          SFX.coin();
          renderPlannerBoard();
        };

        if (assignedZone && zones[assignedZone]) {
          zones[assignedZone].appendChild(cardEl);
        } else {
          tray.appendChild(cardEl);
        }
      });

      if (tray.children.length === 0) {
        tray.innerHTML = `<span style="color:#16a34a; font-weight:700; font-size:0.88rem;">✅ จัดกิจกรรมทั้งหมดลงตารางเรียบร้อยแล้ว!</span>`;
      }
    }

    function handleZoneDragOver(e) {
      e.preventDefault();
      e.currentTarget.classList.add("drag-over");
    }
    function handleZoneDragLeave(e) {
      e.currentTarget.classList.remove("drag-over");
    }
    function handleZoneDrop(e, zoneName) {
      e.preventDefault();
      e.currentTarget.classList.remove("drag-over");
      const itemId = e.dataTransfer.getData("text/plain");
      if (itemId) {
        assignCardToZone(itemId, zoneName);
      }
    }
    function handleZoneTap(zoneName) {
      if (state.selectedPlanCardId) {
        assignCardToZone(state.selectedPlanCardId, zoneName);
        state.selectedPlanCardId = null;
      }
    }

    function assignCardToZone(itemId, zoneName) {
      state.plannerAssignments[itemId] = zoneName;
      SFX.coin();
      renderPlannerBoard();
    }

    function autoAssignPlanner() {
      state.wonItems.forEach(it => {
        state.plannerAssignments[it.id] = it.zone;
      });
      SFX.gavel();
      renderPlannerBoard();
    }

    function finishPlannerPhase() {
      // คำนวณโบนัสจากการจัดวางตรงโซน 8-8-8
      let correctZoneCount = 0;
      state.wonItems.forEach(it => {
        if (state.plannerAssignments[it.id] === it.zone) {
          correctZoneCount++;
        }
      });
      if (correctZoneCount > 0) {
        state.score += correctZoneCount * 2;
      }
      startTwistPhase();
    }

    /* ==========================================================================
       ส่วนที่ 8: ขั้นตอนที่ 3 - เหตุการณ์ไม่คาดฝัน (INTERACTIVE PLOT TWIST)
       ========================================================================== */
    function startTwistPhase() {
      const lvl = getCurrentLevelData();
      const twist = lvl.twists[0];
      SFX.alert();
      switchScreen("screen-twist");

      document.getElementById("twist-title").textContent = twist.title;
      document.getElementById("twist-desc").textContent = twist.desc;

      const hasShield = state.wonItems.some(it => it.id === twist.shieldId);
      const shieldEl = document.getElementById("twist-shield-status");

      if (hasShield) {
        shieldEl.className = "feedback-banner good";
        shieldEl.innerHTML = `<span>🛡️</span><span>${twist.shieldMsg}</span>`;
      } else {
        shieldEl.className = "feedback-banner warn";
        shieldEl.innerHTML = `<span>💥</span><span>${twist.noShieldMsg}</span>`;
        state.vitals.health = Math.max(0, state.vitals.health + twist.noShieldPenalty.health);
        state.vitals.study = Math.max(0, state.vitals.study + twist.noShieldPenalty.study);
        state.vitals.happy = Math.max(0, state.vitals.happy + twist.noShieldPenalty.happy);
        state.score = Math.max(0, state.score + twist.noShieldPenalty.score);
      }

      const choicesEl = document.getElementById("twist-choices");
      choicesEl.innerHTML = twist.choices.map((ch, idx) => `
        <button class="choice-btn" onclick="resolveTwistChoice(${idx})">${ch.text}</button>
      `).join("");
    }

    function resolveTwistChoice(choiceIdx) {
      const lvl = getCurrentLevelData();
      const twist = lvl.twists[0];
      const choice = twist.choices[choiceIdx];

      state.vitals.health = Math.max(0, Math.min(100, state.vitals.health + choice.delta.health));
      state.vitals.study = Math.max(0, Math.min(100, state.vitals.study + choice.delta.study));
      state.vitals.happy = Math.max(0, Math.min(100, state.vitals.happy + choice.delta.happy));
      state.score = Math.max(0, state.score + choice.delta.score);

      state.totalDecisions++;
      if (choice.delta.score > 0) state.goodDecisions++;

      showFinalDashboard(choice.feedback);
    }

    function checkImmediateGameOver() {
      if (state.vitals.health <= 0 || state.vitals.study <= 0 || state.vitals.happy <= 0) {
        clearAllTimers();
        SFX.fail();
        showFinalDashboard("พลังชีวิตด้านหนึ่งลดลงเหลือ 0% ระหว่างวัน! อย่าทุ่มเวลาให้ด้านเดียวจนละเลยพื้นฐานชีวิตนะ", true);
        return true;
      }
      return false;
    }

    /* ==========================================================================
       ส่วนที่ 9: หน้าสรุปผล & SVG LIFE PIE CHART DASHBOARD
       ========================================================================== */
    function showFinalDashboard(twistFeedback, forcedFail = false) {
      switchScreen("screen-result");

      const isGameOver = forcedFail || state.vitals.health <= 0 || state.vitals.study <= 0 || state.vitals.happy <= 0;

      // คำนวณโบนัสสมดุลครบ 3 ด้าน (8-8-8 Balance Bonus)
      const zonesUsed = new Set(state.wonItems.filter(i => i.isGood).map(i => i.zone));
      if (!isGameOver && zonesUsed.size === 3) {
        state.score += 8;
      }

      const accuracyRate = state.totalDecisions > 0
        ? Math.round((state.goodDecisions / state.totalDecisions) * 100)
        : 0;

      // บันทึก High Score และปลดล็อกด่านถัดไป
      const prevHigh = saveData.highScores[state.selectedLevel] || 0;
      if (state.score > prevHigh) {
        saveData.highScores[state.selectedLevel] = state.score;
      }
      if (!isGameOver && state.selectedLevel < 3 && saveData.unlockedLevel <= state.selectedLevel) {
        saveData.unlockedLevel = state.selectedLevel + 1;
      }
      persistSaveData();

      // กำหนดฉายาประจำวัน
      let titleBadge = "นักบริหารเวลาฝึกหัด";
      const totalDistractHrs = state.wonItems.filter(i => !i.isGood).reduce((s, i) => s + i.hours, 0);
      const totalStudyHrs = state.wonItems.filter(i => i.zone === "work").reduce((s, i) => s + i.hours, 0);
      const totalRestHrs = state.wonItems.filter(i => i.zone === "rest").reduce((s, i) => s + i.hours, 0);

      if (isGameOver) {
        titleBadge = "ชาวฟาร์มผู้หมดแรง (ต้องจัดสมดุลใหม่!)";
        SFX.fail();
      } else if (zonesUsed.size === 3 && totalDistractHrs === 0 && state.score >= 45) {
        titleBadge = "ปรมาจารย์ฟาร์มสมดุลทองคำ 🏆";
        SFX.victory();
      } else if (totalDistractHrs >= 5) {
        titleBadge = "ชาวฟาร์มนักไถจอ (ระวังกับดักเวลา!)";
        SFX.victory();
      } else if (totalStudyHrs >= 10 && totalRestHrs < 6) {
        titleBadge = "เจ้าฟาร์มผู้ขยันขันแข็ง (อย่าลืมพักผ่อนนะ!)";
        SFX.victory();
      } else if (totalRestHrs >= 8 && totalStudyHrs === 0) {
        titleBadge = "เจ้าฟาร์มขี้เซาจอมพักผ่อน 😴";
        SFX.victory();
      } else {
        titleBadge = "ชาวฟาร์มนักจัดสรรเวลา 🌻";
        SFX.victory();
      }

      document.getElementById("result-badge-icon").textContent = isGameOver ? "💫" : "🏆";
      document.getElementById("result-heading").textContent = isGameOver
        ? "จบวันก่อนกำหนด! มาทบทวนบทเรียนกันเถอะ"
        : "สรุปผลภารกิจบริหารเวลา 24 ชั่วโมง!";
      document.getElementById("result-title-badge").textContent = titleBadge;

      const stars = isGameOver ? "⭐" : (state.score >= 48 ? "⭐⭐⭐" : state.score >= 30 ? "⭐⭐" : "⭐");
      document.getElementById("result-stars").textContent = stars;

      document.getElementById("final-score").textContent = state.score;
      document.getElementById("final-accuracy").textContent = `${accuracyRate}%`;
      document.getElementById("final-highscore").textContent = saveData.highScores[state.selectedLevel];

      const nextBtn = document.getElementById("btn-next-level");
      nextBtn.style.display = (!isGameOver && state.selectedLevel < 3) ? "inline-flex" : "none";

      // วาดแผนภาพวงกลมชีวิต 24 ชั่วโมง (SVG Pie Chart)
      renderLifePieChart(totalRestHrs, totalStudyHrs, totalDistractHrs);

      // สร้างข้อเสนอแนะรายบุคคล
      const feedbackList = [];
      feedbackList.push(`<strong>ผลจากเหตุการณ์ท้ายวัน:</strong> ${twistFeedback}`);
      if (totalRestHrs < 6) {
        feedbackList.push("🛏️ <strong>ด้านการพักผ่อน:</strong> คุณจัดเวลาพักผ่อนน้อยกว่า 6 ชม. การอดนอนส่งผลเสียต่อความจำและภูมิคุ้มกันโดยตรง");
      } else {
        feedbackList.push("🛏️ <strong>ด้านการพักผ่อน:</strong> ยอดเยี่ยม! คุณเห็นความสำคัญของการนอนหลับพักผ่อนอย่างเพียงพอ");
      }
      if (totalDistractHrs > 0) {
        feedbackList.push(`📱 <strong>ด้านการรู้เท่าทันสื่อ (Digital Literacy):</strong> คุณเสียเวลา ${totalDistractHrs} ชม. ไปกับกิจกรรมที่ไม่มีเป้าหมาย ลองลดเวลาส่วนนี้เพื่อเพิ่มโอกาสพัฒนาตนเอง`);
      }
      if (zonesUsed.size === 3) {
        feedbackList.push("⚖️ <strong>สูตรสมดุล 8-8-8:</strong> คุณจัดสรรเวลาได้ครบทั้ง 3 ด้าน (พักผ่อน / เรียน / สุขภาพและความสัมพันธ์) ได้รับโบนัสสมดุลชีวิต!");
      } else {
        feedbackList.push("⚖️ <strong>สูตรสมดุล 8-8-8:</strong> ลองวางแผนให้มีกิจกรรมครบทั้ง 3 ด้านในรอบถัดไป เพื่อสร้างเกราะป้องกันความเครียด");
      }

      document.getElementById("personal-feedback-list").innerHTML = feedbackList.map(item => `<li>${item}</li>`).join("");
    }

    function renderLifePieChart(restHrs, studyHrs, distractHrs) {
      const lifeGoodHrs = state.wonItems
        .filter(i => i.zone === "life" && i.isGood)
        .reduce((s, i) => s + i.hours, 0);
      const usedTotal = restHrs + studyHrs + lifeGoodHrs + distractHrs;
      const wastedHrs = Math.max(0, 24 - usedTotal);

      const segments = [
        { label: "พักผ่อนนอนหลับ", hours: restHrs, color: "#3b82f6" },
        { label: "เรียน & พัฒนาตนเอง", hours: studyHrs, color: "#22c55e" },
        { label: "สุขภาพ & ครอบครัว", hours: lifeGoodHrs, color: "#f59e0b" },
        { label: "สิ่งล่อใจ / โซเชียล", hours: distractHrs, color: "#ef4444" },
        { label: "เวลาที่ปล่อยทิ้งเปล่า", hours: wastedHrs, color: "#cbd5e1" }
      ];

      const svg = document.getElementById("life-pie-svg");
      const cx = 105, cy = 105, r = 82;
      let cumulativeAngle = -Math.PI / 2;
      let pathsHtml = "";

      segments.forEach(seg => {
        if (seg.hours <= 0) return;
        const sliceAngle = (seg.hours / 24) * Math.PI * 2;
        if (seg.hours >= 24) {
          pathsHtml += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${seg.color}"/>`;
        } else {
          const x1 = cx + r * Math.cos(cumulativeAngle);
          const y1 = cy + r * Math.sin(cumulativeAngle);
          const endAngle = cumulativeAngle + sliceAngle;
          const x2 = cx + r * Math.cos(endAngle);
          const y2 = cy + r * Math.sin(endAngle);
          const largeArc = sliceAngle > Math.PI ? 1 : 0;
          pathsHtml += `<path d="M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${largeArc} 1 ${x2} ${y2} Z" fill="${seg.color}" stroke="#ffffff" stroke-width="2"/>`;
          cumulativeAngle = endAngle;
        }
      });

      // วงกลมตรงกลางแบบ Donut Chart
      pathsHtml += `<circle cx="${cx}" cy="${cy}" r="38" fill="#ffffff"/>`;
      pathsHtml += `<text x="${cx}" y="${cy + 5}" text-anchor="middle" font-size="14" font-weight="900" fill="#1e293b">24 ชม.</text>`;
      svg.innerHTML = pathsHtml;

      document.getElementById("pie-legend").innerHTML = segments.map(seg => `
        <div class="legend-item">
          <span><span class="dot" style="background:${seg.color};"></span>${seg.label}</span>
          <strong>${seg.hours} ชม.</strong>
        </div>
      `).join("");
    }

    function playNextLevel() {
      if (state.selectedLevel < 3) {
        state.selectedLevel++;
        startGame();
      }
    }

    /* ==========================================================================
       ส่วนที่ 10: การควบคุมหน้าต่าง Modal (วิธีเล่น / คลังความรู้ / สถิติ)
       ========================================================================== */
    function openModal(id) {
      if (id === "modal-scores") renderHighScoreTable();
      document.getElementById(id).classList.add("open");
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove("open");
    }
    function closeModalOnBg(e, id) {
      if (e.target.id === id) closeModal(id);
    }

    function renderHighScoreTable() {
      const container = document.getElementById("highscore-table-container");
      container.innerHTML = GAME_CONFIG.levels.map(lvl => `
        <div style="display:flex; justify-content:space-between; padding:12px; background:#fffbeb; border-radius:12px; border:1px solid #fde68a; margin-bottom:8px;">
          <strong>${lvl.name}</strong>
          <span style="font-weight:900; color:#b45309;">🏆 ${saveData.highScores[lvl.id] || 0} คะแนน</span>
        </div>
      `).join("");
    }

    // เริ่มต้นระบบเมื่อโหลดหน้าเว็บเสร็จสมบูรณ์
    window.addEventListener("DOMContentLoaded", () => {
      initStartScreen();
    });
  </script>
</body>
</html>
